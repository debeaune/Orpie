{% extends 'base.html.twig' %}
{% block body %}
    <div class="container">
        <section>
            <table>
                <tr>
                    <td colspan="2">
                        {% if detail.default_photo is defined and detail.default_photo %}
                            <img src="{{ detail.default_photo.medium_url }}" style="width: 500px" alt="photo">
                        {% endif %}
                    </td>
                </tr>
                <tr><td class="bold">Nom latin</td><td>{{ detail.name ?? resultat.espece }}</td></tr>
                <tr><td class="bold">Nom anglais</td><td>{{ detail.preferred_common_name ?? '...' }}</td></tr>
                <tr><td class="bold">Groupe</td><td>{{ resultat.genre }}</td></tr>
                <tr><td class="bold">Habitat</td><td>{{ resultat.habitat ?? '...' }}</td></tr>
                <tr>
                    <td class="bold">Statut de conservation</td>
                    <td>
                        {% if detail.conservation_status is defined and detail.conservation_status %}
                            {{ detail.conservation_status.status_name }}
                        {% else %}
                            ...
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td class="bold">Wikipedia</td>
                    <td>
                        {% if detail.wikipedia_url is defined and detail.wikipedia_url %}
                            <a href="{{ detail.wikipedia_url }}" target="_blank">Voir sur Wikipedia</a>
                        {% else %}...{% endif %}
                    </td>
                </tr>
            </table>
        </section>
    </div>
{% endblock %}


